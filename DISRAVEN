local keyInputHidden = ""
keyInput:GetPropertyChangedSignal("Text"):Connect(function()
    if isKeyHidden then
        local currentText = keyInput.Text
        if #currentText > #keyInputHidden then
            keyInputHidden = keyInputHidden .. string.sub(currentText, #currentText)
        elseif #currentText < #keyInputHidden then
            keyInputHidden = string.sub(keyInputHidden, 1, #currentText)
        end
        keyInput.Text = string.rep("•", #keyInputHidden)
    else
        keyInputHidden = keyInput.Text
    end
end)

hideKeyBtn.MouseButton1Click:Connect(function()
    isKeyHidden = not isKeyHidden
    if isKeyHidden then
        keyInput.Text = string.rep("•", #keyInputHidden)
    else
        keyInput.Text = keyInputHidden
    end
end)

