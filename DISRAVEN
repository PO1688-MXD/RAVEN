-- ESP Loop สแกนหาไข่ในแมพ
task.spawn(function()
    while task.wait(1) do
        if eggActive then
            espFolder:ClearAllChildren()
            for _, obj in pairs(Workspace:GetDescendants()) do
                if obj:IsA("BasePart") and (string.find(string.lower(obj.Name), "egg") or obj:FindFirstChild("Weight")) then
                    -- กล่องสี่เหลี่ยมสีดำครอบไข่
                    local box = Instance.new("SelectionBox")
                    box.Color3 = Color3.fromRGB(0, 0, 0)
                    box.Adornee = obj
                    box.Parent = espFolder
                    
                    -- ตัวหนังสือแสดงชื่อ + น้ำหนัก
                    local bb = Instance.new("BillboardGui")
                    bb.Size = UDim2.new(0, 100, 0, 40)
                    bb.AlwaysOnTop = true
                    bb.Adornee = obj
                    
                    local txt = Instance.new("TextLabel")
                    txt.Size = UDim2.new(1, 0, 1, 0)
                    txt.BackgroundTransparency = 1
                    txt.TextColor3 = Color3.fromRGB(255, 255, 0)
                    txt.TextSize = 14
                    txt.Font = Enum.Font.SourceSansBold
                    
                    local weightVal = obj:FindFirstChild("Weight") and obj.Weight.Value or "N/A"
                    txt.Text = obj.Name .. "\nน้ำหนัก: " .. tostring(weightVal)
                    txt.Parent = bb
                    bb.Parent = espFolder
                end
            end
        end
    end
end)

